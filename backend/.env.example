# =============================================================================
# PaperLens AI - Backend Environment Configuration Example
# Copy this file to .env and populate with your own credentials.
# =============================================================================

# Database (PostgreSQL / Supabase / SQLite)
DATABASE_URL=postgresql://user:password@localhost:5432/paperlens

# Authentication (Clerk)
CLERK_SECRET_KEY=sk_test_...

# AI & LLM Inference Keys
GROQ_API_KEY=gsk_...

# Academic Data Sources
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_here
CITATION_MAX_REFERENCES=30

# Supabase Storage & Vector DB (Optional if using direct Postgres)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key

